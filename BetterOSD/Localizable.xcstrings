    "Turn On Built-in Display": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebautes Display einschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encender la pantalla integrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
