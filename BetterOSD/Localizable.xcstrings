    "Media keys can't be used — press a regular key with ⌃/⌥/⇧/⌘.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten funktionieren nicht – drücke eine normale Taste mit ⌃/⌥/⇧/⌘."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas de medios no sirven: pulsa una tecla normal con ⌃/⌥/⇧/⌘."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches média ne conviennent pas — appuyez sur une touche classique avec ⌃/⌥/⇧/⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアキーは使用できません。⌃/⌥/⇧/⌘を押しながら通常のキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 키는 사용할 수 없습니다. ⌃/⌥/⇧/⌘와 함께 일반 키를 누르세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиа-клавиши не подходят — нажмите обычную клавишу с ⌃/⌥/⇧/⌘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体键不可用——请按下带 ⌃/⌥/⇧/⌘ 的普通按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "媒體鍵無法使用——請按下搭配 ⌃/⌥/⇧/⌘ 的一般按鍵。"
          }
        }
      }
    },
