    "F1/F2 are reserved for brightness — pick another key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 sind für die Helligkeit reserviert – wähle eine andere Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 están reservadas para el brillo: elige otra tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 sont réservées à la luminosité — choisissez une autre touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2は明るさ調整用に予約されています。別のキーを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2는 밝기 조절용으로 예약되어 있습니다. 다른 키를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 заняты под яркость — выберите другую клавишу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 已保留用于调节亮度——请选择其他按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "F1/F2 已保留用於調整亮度——請選擇其他按鍵。"
          }
        }
      }
    },
