          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ディスプレイをオン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 디스플레이 켜기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить встроенный дисплей"
          }
        },
