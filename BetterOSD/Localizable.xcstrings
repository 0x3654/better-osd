    "Uses Command+F1 and Command+F2. No changes to system key assignments.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Command+F1 und Command+F2. Keine Änderungen an Systemtastenbelegungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Command+F1 y Command+F2. Sin cambios en las asignaciones de teclas del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Command+F1 et Command+F2. Aucun changement des affectations de touches système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command+F1とCommand+F2を使用します。システムキー割り当ての変更はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command+F1 및 Command+F2를 사용합니다. 시스템 키 할당 변경 없음."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует Command+F1 и Command+F2. Системные назначения клавиш не меняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Command+F1 和 Command+F2。不更改系统按键分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Command+F1 和 Command+F2。不更改系統按鍵分配。"
          }
        }
      }
    },
